{
  "private": true,
  "name": "emotes-resizer",
  "version": "0.0.10",
  "main": ".vite/build/main.cjs",
  "description": "Desktop application for resizing emotes using Electron and Nuxt",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Yizack Rangel",
    "email": "yizackr@gmail.com",
    "url": "https://yizack.com"
  },
  "homepage": "https://emotes-resizer.yizack.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yizack/emotes-resizer.git"
  },
  "bugs": "https://github.com/Yizack/emotes-resizer/issues",
  "scripts": {
    "start": "electron-forge start",
    "dev": "concurrently \"nuxt dev\" \"cross-env NODE_ENV=development electron-forge start\"",
    "build": "nuxt generate && electron-forge make",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "node --run lint && node --run test:types && nuxt generate && changelogen --release --push --no-github",
    "release:github": "changelogen gh release",
    "lint": "node --run lint:eslint && node --run lint:stylelint",
    "lint:fix": "node --run lint:eslint --fix && node --run lint:stylelint --fix",
    "lint:eslint": "eslint --config .config/eslint.mjs",
    "lint:eslint:inspect": "pnpm dlx @eslint/config-inspector --config .config/eslint.mjs",
    "lint:stylelint": "stylelint \"**/*.{css,scss,sass}\" --config .config/stylelint.json",
    "test:types": "vue-tsc -b --noEmit",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@iconify-json/lucide": "^1.2.132",
    "@nuxt/ui": "^4.11.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^25.3.3",
    "@yizack/eslint-config": "^0.0.6",
    "changelogen": "^0.6.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-packager-languages": "^0.6.0",
    "nuxt": "^4.5.2",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "sharp": "^0.35.4"
  },
  "config": {
    "forge": ".config/forge.ts"
  },
  "packageManager": "pnpm@12.4.2"
}
